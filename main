      <div class="flex items-center justify-between mb-4 border-b border-obsidian-800 pb-3">
        <h3 class="text-base font-bold text-white flex items-center gap-2">
          <i class="fa-solid fa-diagram-project text-purple-400"></i> Criar Novo Projeto
        </h3>
        <button onclick="toggleModalProjeto(false)" class="text-zinc-400 hover:text-white text-lg">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>

      <form id="form-novo-projeto" onsubmit="adicionarProjeto(event)" class="space-y-3.5">
        <div>
          <label class="block text-xs font-semibold text-zinc-400 mb-1">Nome do Projeto</label>
          <input type="text" id="projeto-nome" placeholder="Ex: Lançamento SaaS V2" class="glass-input w-full px-3 py-2 rounded-xl text-xs" required />
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-semibold text-zinc-400 mb-1">Área / Unidade</label>
            <input type="text" id="projeto-area" placeholder="Ex: Produto, Mkt, Pessoal" class="glass-input w-full px-3 py-2 rounded-xl text-xs" required />
          </div>
          <div>
            <label class="block text-xs font-semibold text-zinc-400 mb-1">Status</label>
            <select id="projeto-status" class="glass-input w-full px-3 py-2 rounded-xl text-xs">
              <option value="planejamento">📋 Planejamento</option>
              <option value="em_andamento" selected>🚀 Em Andamento</option>
              <option value="travado">⚠️ Travado</option>
              <option value="concluido">✅ Concluído</option>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div class="col-span-2 sm:col-span-1">
            <label class="block text-xs font-semibold text-zinc-400 mb-1">Prazo Estimado</label>
            <input type="date" id="projeto-prazo" class="glass-input w-full px-3 py-2 rounded-xl text-xs" />
          </div>
          <div class="col-span-2 sm:col-span-1">
            <label class="block text-xs font-semibold text-zinc-400 mb-1">Meta Principal (KPI)</label>
            <input type="text" id="projeto-meta" placeholder="Ex: $10k MRR ou 500 leads" class="glass-input w-full px-3 py-2 rounded-xl text-xs" />
          </div>
        </div>

        <div class="flex items-center justify-end gap-2 pt-3 border-t border-obsidian-800">
          <button type="button" onclick="toggleModalProjeto(false)" class="px-4 py-2 rounded-xl text-xs font-semibold text-zinc-400 hover:text-white bg-obsidian-900 border border-obsidian-800">
            Cancelar
          </button>
          <button type="submit" class="px-5 py-2 rounded-xl text-xs font-bold text-white bg-purple-600 hover:bg-purple-500 transition shadow-lg shadow-purple-600/20">
            Salvar Projeto
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- ==================== MOBILE BOTTOM NAVIGATION ==================== -->
  <nav class="bottom-nav fixed bottom-0 left-0 right-0 z-40 glass-panel border-t border-obsidian-800 px-3 py-2">
    <div class="grid grid-cols-4 gap-1 max-w-md mx-auto">
      <button onclick="switchTab('hoje')" id="mob-nav-hoje" class="flex flex-col items-center justify-center py-1 text-blue-500">
        <i class="fa-regular fa-calendar-check text-lg"></i>
        <span class="text-[10px] font-semibold mt-1">Hoje</span>
      </button>
      <button onclick="switchTab('financas')" id="mob-nav-financas" class="flex flex-col items-center justify-center py-1 text-zinc-400">
        <i class="fa-solid fa-chart-line text-lg"></i>
        <span class="text-[10px] font-medium mt-1">Finanças</span>
      </button>
      <button onclick="switchTab('projetos')" id="mob-nav-projetos" class="flex flex-col items-center justify-center py-1 text-zinc-400">
        <i class="fa-solid fa-layer-group text-lg"></i>
        <span class="text-[10px] font-medium mt-1">Projetos</span>
      </button>
      <button onclick="switchTab('estudos')" id="mob-nav-estudos" class="flex flex-col items-center justify-center py-1 text-zinc-400">
        <i class="fa-solid fa-graduation-cap text-lg"></i>
        <span class="text-[10px] font-medium mt-1">Estudos</span>
      </button>
    </div>
  </nav>

  <!-- ==================== SUPABASE LOGIC & APP ENGINE ==================== -->
  <script>
    // 1. SUPABASE CLIENT INITIALIZATION
    const SUPABASE_URL = "https://grsjmqsrvywxmncijbsj.supabase.co";
    const SUPABASE_ANON_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imdyc2ptcXNydnl3eG1uY2lqYnNqIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODY3MzIwMDMsImV4cCI6MjEwMjMwODAwM30.dEyk9ojUWijsU018wPD1V8eanQTRKpajWstAQc6c3jw";
    
    const db = supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

    let activeTab = 'hoje';
    let currentSaudeId = null;

    // 2. HELPER FUNCTIONS & UI FEEDBACK
    function showToast(message, type = 'success') {
      const container = document.getElementById('toast-container');
      const toast = document.createElement('div');
      const bgColors = {
        success: 'bg-emerald-950/90 border-emerald-800 text-emerald-200',
        error: 'bg-rose-950/90 border-rose-800 text-rose-200',
        info: 'bg-blue-950/90 border-blue-800 text-blue-200'
      };
      const icons = {
        success: 'fa-circle-check text-emerald-400',
        error: 'fa-triangle-exclamation text-rose-400',
        info: 'fa-circle-info text-blue-400'
      };

      toast.className = `pointer-events-auto flex items-center gap-3 px-4 py-3 rounded-xl border backdrop-blur-md shadow-2xl transition-all duration-300 transform translate-y-2 opacity-0 text-xs font-medium ${bgColors[type] || bgColors.info}`;
      toast.innerHTML = `
        <i class="fa-solid ${icons[type] || icons.info} text-sm"></i>
        <div class="flex-1">${message}</div>
      `;

      container.appendChild(toast);
      requestAnimationFrame(() => {
        toast.classList.remove('translate-y-2', 'opacity-0');
      });

      setTimeout(() => {
        toast.classList.add('opacity-0', 'translate-y-[-8px]');
        setTimeout(() => toast.remove(), 300);
      }, 3500);
    }

    function formatBRL(val) {
      return new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(val || 0);
    }

    function getTodayDateString() {
      return new Date().toISOString().split('T')[0];
    }

    // Tab Navigation Logic
    function switchTab(tab) {
      activeTab = tab;
      
      // Toggle Tab Views
      document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
      const activeContent = document.getElementById(`tab-${tab}`);
      if (activeContent) activeContent.classList.remove('hidden');

      // Desktop Nav Styling
      document.querySelectorAll('.tab-btn').forEach(btn => {
        btn.classList.remove('bg-obsidian-800', 'text-white');
        btn.classList.add('text-zinc-400');
      });
      const activeNavBtn = document.getElementById(`nav-btn-${tab}`);
      if (activeNavBtn) {
        activeNavBtn.classList.add('bg-obsidian-800', 'text-white');
        activeNavBtn.classList.remove('text-zinc-400');
      }

      // Mobile Nav Styling
      ['hoje', 'financas', 'projetos', 'estudos'].forEach(t => {
        const mobBtn = document.getElementById(`mob-nav-${t}`);
        if (!mobBtn) return;
        if (t === tab) {
          mobBtn.className = 'flex flex-col items-center justify-center py-1 text-blue-500 font-bold';
        } else {
          mobBtn.className = 'flex flex-col items-center justify-center py-1 text-zinc-400';
        }
      });

      refreshCurrentTab();
    }

    function refreshCurrentTab() {
      const syncIcon = document.getElementById('sync-icon');
      if (syncIcon) syncIcon.classList.add('fa-spin');

      let promise = Promise.resolve();
      if (activeTab === 'hoje') {
        promise = Promise.all([carregarSaudeHoje(), carregarPrioridades()]);
      } else if (activeTab === 'financas') {
        promise = carregarFinancas();
      } else if (activeTab === 'projetos') {
        promise = carregarProjetos();
      } else if (activeTab === 'estudos') {
        promise = carregarEstudos();
      }

      promise.finally(() => {
        setTimeout(() => {
          if (syncIcon) syncIcon.classList.remove('fa-spin');
        }, 400);
      });
    }

    // ==================== 3. MÓDULO: HOJE & ROTINA ====================
    async function carregarSaudeHoje() {
      const today = getTodayDateString();
      try {
        const { data, error } = await db
          .from('lifeos_saude')
          .select('*')
          .eq('data', today)
          .maybeSingle();

        if (error) throw error;

        const badge = document.getElementById('saude-status-badge');
        if (data) {
          currentSaudeId = data.id;
          document.getElementById('saude-sono').value = data.horas_sono || '';
          document.getElementById('saude-energia').value = data.energia_nivel || '3';
          document.getElementById('saude-treino-tipo').value = data.treino_tipo || '';
          document.getElementById('saude-treino-concluido').checked = !!data.treino_concluido;
          document.getElementById('saude-notas').value = data.notas || '';
          badge.innerText = "✓ Sincronizado";
          badge.className = "text-[11px] px-2 py-0.5 rounded bg-emerald-950/60 text-emerald-400 font-medium border border-emerald-800/40";
        } else {
          currentSaudeId = null;
          badge.innerText = "Pendente Hoje";
          badge.className = "text-[11px] px-2 py-0.5 rounded bg-amber-950/60 text-amber-400 font-medium border border-amber-800/40";
        }
      } catch (err) {
        console.error("Erro ao carregar saúde:", err);
      }
    }

    async function salvarSaude(e) {
      e.preventDefault();
      const today = getTodayDateString();
      const payload = {
        data: today,
        horas_sono: parseFloat(document.getElementById('saude-sono').value) || 0,
        energia_nivel: parseInt(document.getElementById('saude-energia').value) || 3,
        treino_tipo: document.getElementById('saude-treino-tipo').value,
        treino_concluido: document.getElementById('saude-treino-concluido').checked,
        notas: document.getElementById('saude-notas').value
      };

      try {
        let error;
        if (currentSaudeId) {
          const res = await db.from('lifeos_saude').update(payload).eq('id', currentSaudeId);
          error = res.error;
        } else {
          const res = await db.from('lifeos_saude').insert([payload]);
          error = res.error;
        }

        if (error) throw error;
        showToast('Saúde e biofeedback salvos com sucesso!');
        carregarSaudeHoje();
      } catch (err) {
        showToast(`Erro ao salvar saúde: ${err.message}`, 'error');
      }
    }

    async function carregarPrioridades() {
      const listContainer = document.getElementById('lista-prioridades');
      const countEl = document.getElementById('prioridades-count');
      try {
        const { data, error } = await db
          .from('lifeos_prioridades')
          .select('*')
          .order('concluido', { ascending: true })
          .order('id', { ascending: false });

        if (error) throw error;

        if (!data || data.length === 0) {
          listContainer.innerHTML = `
            <div class="text-center py-8 text-zinc-500 text-xs border border-dashed border-obsidian-800 rounded-xl">
              Nenhuma prioridade registrada. Defina sua meta do dia acima!
            </div>
          `;
          countEl.innerText = "0/0";
          return;
        }

        const concluidas = data.filter(p => p.concluido).length;
        countEl.innerText = `${concluidas}/${data.length}`;

        const pilarColors = {
          negocios: 'bg-purple-950/60 text-purple-400 border-purple-800/40',
          financas: 'bg-emerald-950/60 text-emerald-400 border-emerald-800/40',
          estudos: 'bg-amber-950/60 text-amber-400 border-amber-800/40',
          saude: 'bg-rose-950/60 text-rose-400 border-rose-800/40',
          vida: 'bg-blue-950/60 text-blue-400 border-blue-800/40'
        };

        listContainer.innerHTML = data.map(item => `
          <div class="flex items-center justify-between p-3 rounded-xl bg-obsidian-900/80 border border-obsidian-800 transition hover:border-zinc-700">
            <div class="flex items-center gap-3 flex-1 min-w-0 mr-2">
              <input 
                type="checkbox" 
                ${item.concluido ? 'checked' : ''} 
                onchange="togglePrioridade('${item.id}', this.checked)"
                class="w-4 h-4 rounded text-blue-600 focus:ring-0 bg-zinc-950 border-zinc-700 cursor-pointer"
              />
              <span class="text-xs font-semibold px-2 py-0.5 rounded border uppercase text-[10px] ${pilarColors[item.pilar] || 'bg-zinc-800 text-zinc-400'}">
                ${item.pilar}
              </span>
              <span class="text-xs text-zinc-200 truncate ${item.concluido ? 'line-through text-zinc-500' : ''}">
                ${item.descricao}
              </span>
            </div>
            <button onclick="deletarPrioridade('${item.id}')" class="text-zinc-500 hover:text-rose-400 p-1 transition" title="Remover">
              <i class="fa-solid fa-trash-can text-xs"></i>
            </button>
          </div>
        `).join('');
      } catch (err) {
        listContainer.innerHTML = `<div class="text-rose-400 text-xs py-4">Erro ao carregar prioridades: ${err.message}</div>`;
      }
    }

    async function adicionarPrioridade(e) {
      e.preventDefault();
      const pilar = document.getElementById('prioridade-pilar').value;
      const descricao = document.getElementById('prioridade-descricao').value.trim();

      if (!descricao) return;

      try {
        const { error } = await db.from('lifeos_prioridades').insert([{
          pilar,
          descricao,
          concluido: false,
          data: getTodayDateString()
        }]);

        if (error) throw error;

        document.getElementById('prioridade-descricao').value = '';
        showToast('Prioridade adicionada com sucesso!');
        carregarPrioridades();
      } catch (err) {
        showToast(`Erro ao adicionar prioridade: ${err.message}`, 'error');
      }
    }

    async function togglePrioridade(id, concluido) {
      try {
        const { error } = await db.from('lifeos_prioridades').update({ concluido }).eq('id', id);
        if (error) throw error;
        carregarPrioridades();
      } catch (err) {
        showToast(`Erro ao atualizar prioridade: ${err.message}`, 'error');
      }
    }

    async function deletarPrioridade(id) {
      try {
        const { error } = await db.from('lifeos_prioridades').delete().eq('id', id);
        if (error) throw error;
        showToast('Prioridade removida.');
        carregarPrioridades();
      } catch (err) {
        showToast(`Erro ao remover: ${err.message}`, 'error');
      }
    }

    // ==================== 4. MÓDULO: FINANÇAS & APORTES ====================
    async function carregarFinancas() {
      const tableBody = document.getElementById('tabela-financas-body');
      try {
        const { data, error } = await db
          .from('lifeos_financas')
          .select('*')
          .order('data', { ascending: false })
          .order('id', { ascending: false });

        if (error) throw error;

        let totReceitas = 0;
        let totDespesas = 0;
        let totInvest = 0;

        if (data && data.length > 0) {
          data.forEach(f => {
            const v = parseFloat(f.valor) || 0;
            if (f.tipo === 'receita') totReceitas += v;
            else if (f.tipo === 'despesa') totDespesas += v;
            else if (f.tipo === 'investimento') totInvest += v;
          });

          tableBody.innerHTML = data.map(item => {
            const isReceita = item.tipo === 'receita';
            const isInvest = item.tipo === 'investimento';
            const valColor = isReceita ? 'text-emerald-400' : (isInvest ? 'text-blue-400' : 'text-rose-400');
            const prefix = isReceita ? '+' : (isInvest ? '⚡' : '-');

            const typeBadge = {
              receita: '<span class="px-1.5 py-0.5 rounded bg-emerald-950 border border-emerald-800 text-emerald-300 text-[10px]">Receita</span>',
              despesa: '<span class="px-1.5 py-0.5 rounded bg-rose-950 border border-rose-800 text-rose-300 text-[10px]">Despesa</span>',
              investimento: '<span class="px-1.5 py-0.5 rounded bg-blue-950 border border-blue-800 text-blue-300 text-[10px]">Aporte</span>'
            }[item.tipo] || '';

            const dataFormatted = item.data ? new Date(item.data + 'T00:00:00').toLocaleDateString('pt-BR') : '-';

            return `
              <tr class="hover:bg-obsidian-900/50 transition">
                <td class="py-3 pr-2">
                  <div class="font-medium text-zinc-200">${item.descricao || item.categoria}</div>
                  <div class="text-[10px] text-zinc-500">${dataFormatted}</div>
                </td>
                <td class="py-3 px-2">
                  <div class="flex items-center gap-1.5 mb-0.5">
                    ${typeBadge}
                    <span class="text-[10px] text-zinc-400 capitalize">(${item.origem})</span>
                  </div>
                  <div class="text-[11px] text-zinc-400">${item.categoria}</div>
                </td>
                <td class="py-3 px-2 text-right font-mono font-bold ${valColor}">
                  ${prefix} ${formatBRL(item.valor)}
                </td>
                <td class="py-3 pl-2 text-center">
                  <button onclick="deletarFinanca('${item.id}')" class="text-zinc-600 hover:text-rose-400 p-1" title="Excluir">
                    <i class="fa-solid fa-trash-can"></i>
                  </button>
                </td>
              </tr>
            `;
          }).join('');
        } else {
          tableBody.innerHTML = `<tr><td colspan="4" class="text-center py-8 text-zinc-500">Nenhuma movimentação cadastrada.</td></tr>`;
        }

        document.getElementById('total-receitas').innerText = formatBRL(totReceitas);
        document.getElementById('total-despesas').innerText = formatBRL(totDespesas);
        document.getElementById('total-investimentos').innerText = formatBRL(totInvest);

      } catch (err) {
        tableBody.innerHTML = `<tr><td colspan="4" class="text-center py-4 text-rose-400">Erro: ${err.message}</td></tr>`;
      }
    }

    async function adicionarFinanca(e) {
      e.preventDefault();
      const tipo = document.querySelector('input[name="tipo_financa"]:checked').value;
      const origem = document.getElementById('financa-origem').value;
      const valor = parseFloat(document.getElementById('financa-valor').value);
      const categoria = document.getElementById('financa-categoria').value.trim();
      const descricao = document.getElementById('financa-descricao').value.trim();

      if (!valor || !categoria) return;

      try {
        const { error } = await db.from('lifeos_financas').insert([{
          tipo,
          origem,
          valor,
          categoria,
          descricao,
          data: getTodayDateString()
        }]);

        if (error) throw error;

        document.getElementById('financa-valor').value = '';
        document.getElementById('financa-categoria').value = '';
        document.getElementById('financa-descricao').value = '';

        showToast('Movimentação registrada com sucesso!');
        carregarFinancas();
      } catch (err) {
        showToast(`Erro ao salvar finança: ${err.message}`, 'error');
      }
    }

    async function deletarFinanca(id) {
      try {
        const { error } = await db.from('lifeos_financas').delete().eq('id', id);
        if (error) throw error;
        showToast('Lançamento excluído.');
        carregarFinancas();
      } catch (err) {
        showToast(`Erro ao excluir: ${err.message}`, 'error');
      }
    }

    // ==================== 5. MÓDULO: PROJETOS & OPERAÇÕES ====================
    function toggleModalProjeto(show) {
      const modal = document.getElementById('modal-projeto');
      if (show) modal.classList.remove('hidden');
      else modal.classList.add('hidden');
    }

    async function carregarProjetos() {
      const grid = document.getElementById('grid-projetos');
      try {
        const { data, error } = await db
          .from('lifeos_projetos')
          .select('*')
          .order('id', { ascending: false });

        if (error) throw error;

        if (!data || data.length === 0) {
          grid.innerHTML = `
            <div class="col-span-full text-center py-12 text-zinc-500 text-xs border border-dashed border-obsidian-800 rounded-2xl">
              Nenhum projeto ativo no momento. Crie seu primeiro projeto acima.
            </div>
          `;
          return;
        }

        const statusBadges = {
          planejamento: { text: 'Planejamento', cls: 'bg-zinc-800 text-zinc-300 border-zinc-700' },
          em_andamento: { text: 'Em Andamento', cls: 'bg-blue-950 text-blue-400 border-blue-800' },
          travado: { text: 'Travado', cls: 'bg-rose-950 text-rose-400 border-rose-800' },
          concluido: { text: 'Concluído', cls: 'bg-emerald-950 text-emerald-400 border-emerald-800' }
        };

        grid.innerHTML = data.map(proj => {
          const st = statusBadges[proj.status] || statusBadges.planejamento;
          const prazoTxt = proj.prazo ? new Date(proj.prazo + 'T00:00:00').toLocaleDateString('pt-BR') : 'Sem prazo';

          return `
            <div class="glass-panel p-5 rounded-2xl flex flex-col justify-between space-y-4 border border-obsidian-800 hover:border-zinc-700 transition">
              <div>
                <div class="flex items-start justify-between gap-2 mb-2">
                  <span class="text-[10px] font-bold px-2 py-0.5 rounded border uppercase ${st.cls}">
                    ${st.text}
                  </span>
                  <div class="flex items-center gap-1">
                    <select onchange="atualizarStatusProjeto('${proj.id}', this.value)" class="glass-input text-[10px] py-1 px-1.5 rounded-lg">
                      <option value="planejamento" ${proj.status === 'planejamento' ? 'selected' : ''}>📋 Plan</option>
                      <option value="em_andamento" ${proj.status === 'em_andamento' ? 'selected' : ''}>🚀 Andamento</option>
                      <option value="travado" ${proj.status === 'travado' ? 'selected' : ''}>⚠️ Travado</option>
                      <option value="concluido" ${proj.status === 'concluido' ? 'selected' : ''}>✅ Concluído</option>
                    </select>
                    <button onclick="deletarProjeto('${proj.id}')" class="text-zinc-600 hover:text-rose-400 p-1" title="Excluir">
                      <i class="fa-solid fa-trash-can text-xs"></i>
                    </button>
                  </div>
                </div>
                <h4 class="text-sm font-bold text-white mb-1">${proj.nome}</h4>
                <p class="text-xs text-zinc-400 line-clamp-2">${proj.meta_principal || 'Sem meta descrita.'}</p>
              </div>

              <div class="pt-3 border-t border-obsidian-800 flex items-center justify-between text-[11px] text-zinc-400">
                <span class="flex items-center gap-1.5"><i class="fa-regular fa-folder text-zinc-500"></i> ${proj.area || 'Geral'}</span>
                <span class="flex items-center gap-1.5"><i class="fa-regular fa-clock text-zinc-500"></i> ${prazoTxt}</span>
              </div>
            </div>
          `;
        }).join('');
      } catch (err) {
        grid.innerHTML = `<div class="col-span-full text-rose-400 text-xs py-4">Erro ao carregar projetos: ${err.message}</div>`;
      }
    }

    async function adicionarProjeto(e) {
      e.preventDefault();
      const nome = document.getElementById('projeto-nome').value.trim();
      const area = document.getElementById('projeto-area').value.trim();
      const status = document.getElementById('projeto-status').value;
      const prazo = document.getElementById('projeto-prazo').value || null;
      const meta_principal = document.getElementById('projeto-meta').value.trim();

      if (!nome) return;

      try {
        const { error } = await db.from('lifeos_projetos').insert([{
          nome,
          area,
          status,
          prazo,
          meta_principal
        }]);

        if (error) throw error;

        toggleModalProjeto(false);
        document.getElementById('form-novo-projeto').reset();
        showToast('Projeto criado com sucesso!');
        carregarProjetos();
      } catch (err) {
        showToast(`Erro ao criar projeto: ${err.message}`, 'error');
      }
    }

    async function atualizarStatusProjeto(id, status) {
      try {
        const { error } = await db.from('lifeos_projetos').update({ status }).eq('id', id);
        if (error) throw error;
        showToast('Status do projeto atualizado.');
        carregarProjetos();
      } catch (err) {
        showToast(`Erro ao atualizar status: ${err.message}`, 'error');
      }
    }

    async function deletarProjeto(id) {
      try {
        const { error } = await db.from('lifeos_projetos').delete().eq('id', id);
        if (error) throw error;
        showToast('Projeto excluído.');
        carregarProjetos();
      } catch (err) {
        showToast(`Erro ao excluir: ${err.message}`, 'error');
      }
    }

    // ==================== 6. MÓDULO: ESTUDOS & EVOLUÇÃO ====================
    async function carregarEstudos() {
      const container = document.getElementById('lista-estudos');
      try {
        const { data, error } = await db
          .from('lifeos_estudos')
          .select('*')
          .order('id', { ascending: false });

        if (error) throw error;

        if (!data || data.length === 0) {
          container.innerHTML = `
            <div class="col-span-full text-center py-12 text-zinc-500 text-xs border border-dashed border-obsidian-800 rounded-2xl">
              Nenhum tópico de estudo cadastrado. Adicione seu foco de aprendizado ao lado.
            </div>
          `;
          return;
        }

        container.innerHTML = data.map(item => {
          const prog = item.progresso_pct || 0;
          return `
            <div class="glass-panel p-5 rounded-2xl space-y-3 flex flex-col justify-between border border-obsidian-800 hover:border-zinc-700 transition">
              <div>
                <div class="flex items-center justify-between gap-2 mb-2">
                  <span class="text-[10px] font-bold px-2 py-0.5 rounded bg-amber-950/60 border border-amber-800/40 text-amber-400 uppercase">
                    ${item.categoria || 'Geral'}
                  </span>
                  <button onclick="deletarEstudo('${item.id}')" class="text-zinc-600 hover:text-rose-400 p-1" title="Excluir">
                    <i class="fa-solid fa-trash-can text-xs"></i>
                  </button>
                </div>
                <h4 class="text-sm font-bold text-white mb-1">${item.topico}</h4>
                <p class="text-xs text-zinc-400 whitespace-pre-line">${item.anotacao || 'Sem anotações complementares.'}</p>
              </div>

              <div class="space-y-1.5 pt-2 border-t border-obsidian-800">
                <div class="flex items-center justify-between text-xs">
                  <span class="text-zinc-400 font-semibold text-[11px]">Progresso</span>
                  <span class="font-mono font-bold text-amber-400">${prog}%</span>
                </div>
                <div class="w-full bg-obsidian-900 rounded-full h-2 overflow-hidden border border-obsidian-800">
                  <div class="bg-gradient-to-r from-amber-500 to-orange-500 h-full rounded-full transition-all duration-500" style="width: ${prog}%"></div>
                </div>
                <div class="flex items-center gap-2 pt-1">
                  <input 
                    type="range" 
                    min="0" 
                    max="100" 
                    value="${prog}" 
                    onchange="atualizarProgressoEstudo('${item.id}', this.value)"
                    class="w-full h-1 bg-zinc-800 rounded-lg appearance-none cursor-pointer accent-amber-500"
                  />
                </div>
              </div>
            </div>
          `;
        }).join('');
      } catch (err) {
        container.innerHTML = `<div class="col-span-full text-rose-400 text-xs py-4">Erro ao carregar estudos: ${err.message}</div>`;
      }
    }

    async function adicionarEstudo(e) {
      e.preventDefault();
      const topico = document.getElementById('estudo-topico').value.trim();
      const categoria = document.getElementById('estudo-categoria').value.trim();
      const progresso_pct = parseInt(document.getElementById('estudo-progresso').value) || 0;
      const anotacao = document.getElementById('estudo-anotacao').value.trim();

      if (!topico) return;

      try {
        const { error } = await db.from('lifeos_estudos').insert([{
          topico,
          categoria,
          progresso_pct,
          anotacao
        }]);

        if (error) throw error;

        document.getElementById('form-estudos').reset();
        showToast('Tópico de estudo adicionado!');
        carregarEstudos();
      } catch (err) {
        showToast(`Erro ao adicionar estudo: ${err.message}`, 'error');
      }
    }

    async function atualizarProgressoEstudo(id, progresso_pct) {
      try {
        const { error } = await db.from('lifeos_estudos').update({ progresso_pct: parseInt(progresso_pct) }).eq('id', id);
        if (error) throw error;
        showToast(`Progresso atualizado para ${progresso_pct}%`);
        carregarEstudos();
      } catch (err) {
        showToast(`Erro ao atualizar progresso: ${err.message}`, 'error');
      }
    }

    async function deletarEstudo(id) {
      try {
        const { error } = await db.from('lifeos_estudos').delete().eq('id', id);
        if (error) throw error;
        showToast('Estudo excluído.');
        carregarEstudos();
      } catch (err) {
        showToast(`Erro ao excluir: ${err.message}`, 'error');
      }
    }

    // ==================== 7. BOOTSTRAP INITIALIZATION ====================
    window.addEventListener('DOMContentLoaded', () => {
      // Exibir data formatada
      const dateEl = document.getElementById('current-date-display');
      const now = new Date();
      dateEl.innerText = now.toLocaleDateString('pt-BR', { 
        weekday: 'long', 
        year: 'numeric', 
        month: 'long', 
        day: 'numeric' 
      });

      // Carregar dados iniciais da Tab padrão
      refreshCurrentTab();
    });
  </script>
</body>
</html>
